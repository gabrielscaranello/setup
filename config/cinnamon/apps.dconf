[com/linuxmint/updates]
autorefresh-hours=2
default-repo-is-ok=true
hide-kernel-update-warning=true
hide-systray=true
hide-window-after-update=true
refresh-minutes=10
show-welcome-page=false
tracker-grace-period=30
tracker-max-age=15
tracker-max-days=7

[org/cinnamon/desktop/applications/calculator]
exec='gnome-calculator'

[org/x/editor/plugins]
active-plugins=['docinfo', 'modelines', 'bracketcompletion', 'joinlines', 'filebrowser', 'sort', 'spell', 'time', 'open-uri-context-menu', 'textsize']

[org/x/editor/plugins/filebrowser/on-load]
root='file:///'
tree-view=true

[org/x/editor/preferences/ui]
statusbar-visible=true

[org/x/editor/state/window]
bottom-panel-size=140
side-panel-active-page=1541982214
side-panel-size=200

[org/gnome/file-roller/dialogs/extract]
recreate-folders=true
skip-newer=false

[org/gnome/gnome-system-monitor]
maximized=false
network-total-in-bits=false
show-dependencies=false
show-whose-processes='user'

[org/gnome/gnome-system-monitor/disktreenew]
col-6-visible=true

[org/x/warpinator/preferences]
ask-for-send-permission=true
autostart=false
no-overwrite=true
